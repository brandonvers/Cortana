// Lets the user who owns the deployed checkout restart Cortana — that one
// service, that one verb — so cortana-update.service can deploy without root.
// OWNER is filled in at install time; see cortana-update.service.
polkit.addRule(function (action, subject) {
  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    action.lookup("unit") === "cortana.service" &&
    action.lookup("verb") === "restart" &&
    subject.user === "OWNER"
  ) {
    return polkit.Result.YES;
  }
});
