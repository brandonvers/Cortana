# A systemd unit for Cortana.
#
# This is a template. The paths marked below are filled in at install time, and
# packaging proper belongs to M6 — this file exists now because the definition of
# done for M1 says a unit installs, starts on boot, and restarts on failure, and
# because several settings here are the other half of decisions already made in
# the code.
#
# Installing it, as actually performed on the deployment target rather than as
# imagined. Two of these steps were discovered by the service failing:
#
#   1. Node must live somewhere ProtectHome=yes does not hide. A version manager
#      keeps it under $HOME, and the service cannot see it there — the failure is
#      "env: 'node': No such file or directory", which reads like a PATH problem
#      and is not one. Debian 13's own package is too old for the type stripping
#      ADR-0009 relies on, so the version has to come from somewhere else.
#
#   2. The code has to be somewhere else too, for the same reason, and it needs
#      its dependencies installed *there*. Copying a checkout is not enough: the
#      first attempt failed with "Cannot find package '@cortana/config'" because
#      the source had never had an install run in it.
#
#   sudo cp -a "$HOME/.nvm/versions/node/v24.19.0" /opt/node   # or any Node >= 24.12
#   sudo mkdir -p /opt/cortana && sudo cp -a <checkout>/. /opt/cortana/
#   sudo chown -R "$USER":"$USER" /opt/cortana
#   (cd /opt/cortana && pnpm install --frozen-lockfile)
#   sudo chown -R root:root /opt/cortana && sudo chmod -R a+rX /opt/cortana
#
#   sudo useradd --system --home-dir /var/lib/cortana --shell /usr/sbin/nologin cortana
#   sudo cp cortana.service /etc/systemd/system/
#   sudo sed -i "s|^ExecStart=.*|ExecStart=/opt/node/bin/node /opt/cortana/packages/daemon/src/bin.ts|" \
#       /etc/systemd/system/cortana.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now cortana
#
# Verified on Debian 13 on 2026-09-01: starts, survives a reboot, and comes back
# after SIGKILL with NRestarts=1. Making that pleasant is M6's problem.

[Unit]
Description=Cortana
Documentation=https://github.com/brandonvers/Cortana
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=cortana
Group=cortana

# Fill in at install time. Node runs the TypeScript directly; ADR-0009 records
# why there is no build step.
ExecStart=/usr/bin/node /opt/cortana/packages/daemon/src/bin.ts

# systemd creates these, owns them correctly, and exports $STATE_DIRECTORY and
# $CONFIGURATION_DIRECTORY. The config loader prefers $STATE_DIRECTORY for
# dataDir precisely so that a packaged service and a hand-run process agree with
# nothing configured.
StateDirectory=cortana
StateDirectoryMode=0700
ConfigurationDirectory=cortana

# Must exceed the daemon's own shutdown deadline, which defaults to 15s and is
# capped at 600s. systemd sends SIGKILL when this expires, so a value below the
# application's own budget would make the graceful path unreachable.
TimeoutStopSec=45

Restart=on-failure
RestartSec=5
# Exit code 2 is a configuration error (see src/exit.ts). Restarting will fail
# in exactly the same way, so it is not restarted — the operator has to act.
RestartPreventExitStatus=2

# Logs go to stdout as JSON and the journal collects them. No file, no rotation.
StandardOutput=journal
StandardError=journal

# Hardening. Each of these is a real reduction in what a compromised process can
# reach, and none of them interferes with what this one does.
NoNewPrivileges=yes
PrivateTmp=yes

# This gives the service a private /dev holding twelve nodes — measured here as
# char core fd full hugepages log mqueue null ptmx pts random shm. Keeping it
# means a TPM device node is never visible to this process, which is fine: the
# daemon never talks to the TPM, since systemd decrypts credentials before the
# service starts. It does have to *know* whether one is present, in order to
# report honestly what a credential here is worth, and that check therefore looks
# at /sys/class/tpm rather than at /dev — /sys is unaffected by this setting, and
# that was measured rather than assumed. See packages/kernel/src/secrets.ts.
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native

# Deliberately absent: MemoryDenyWriteExecute=yes.
#
# It is on every hardening checklist and it breaks this service. V8 compiles
# JavaScript to machine code at runtime and needs pages that are both writable
# and executable to do it; with this set, Node does not start. Written down here
# because the failure looks like a corrupt install rather than like a policy.

[Install]
WantedBy=multi-user.target
