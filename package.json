{
  "name": "cortana",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted framework for running a team of AI agents on your own machine",
  "license": "MIT",
  "author": "Brandon Scheiber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonvers/Cortana.git"
  },
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:private": "node scripts/check-private.mjs",
    "check:supply-chain": "node scripts/check-supply-chain.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:boundaries && pnpm run check:spikes && pnpm run check:licenses && pnpm run check:supply-chain && pnpm run check:private",
    "check:spikes": "node scripts/check-spikes.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
